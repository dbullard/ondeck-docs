{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OnDeck",
  "description": "Support documentation for Relay and Rivr by OnDeck.",
  "colors": {
    "primary": "#3C63EF",
    "light": "#34C8EE",
    "dark": "#3B2FE0"
  },
  "favicon": "/images/ondeck-logo.png",
  "logo": "/images/ondeck-logo.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "directory": "card",
    "anchors": [
      {
        "anchor": "Home",
        "icon": "house",
        "color": {
          "light": "#3C63EF",
          "dark": "#34C8EE"
        },
        "products": [
          {
            "product": "Relay",
            "icon": "radio-tower",
            "description": "Build live production dashboards, automations, and integrations.",
            "groups": [
              {
                "group": "Get Started",
                "expanded": true,
                "root": "introduction",
                "pages": ["quickstart", "guides/setup-wizard", "core-concepts"]
              },
              {
                "group": "Build Dashboards",
                "expanded": true,
                "root": "dashboards/overview",
                "pages": ["dashboards/tiles", "dashboards/modules", "dashboards/variables", "dashboards/live-mode"]
              },
              {
                "group": "Module guides",
                "expanded": false,
                "pages": ["dashboards/modules/people-planning", "dashboards/modules/audio-visual", "dashboards/modules/video-presentation", "dashboards/modules/wireless", "dashboards/modules/utility"]
              },
              {
                "group": "Automation",
                "expanded": true,
                "root": "dashboards/automation",
                "pages": ["dashboards/nodes/triggers", "dashboards/nodes/actions", "dashboards/nodes/utilities", "dashboards/nodes/sources"]
              },
              {
                "group": "Integrations",
                "expanded": true,
                "root": "integrations/overview",
                "pages": ["integrations/planning-center", "integrations/propresenter", "integrations/youtube-live", "integrations/ndi", "integrations/audio-consoles", "integrations/wireless-devices", "integrations/lighting", "integrations/vista"]
              },
              {
                "group": "Protocols",
                "expanded": true,
                "root": "protocols/overview",
                "pages": ["protocols/osc", "protocols/midi", "protocols/lan-sharing"]
              },
              {
                "group": "Account & Support",
                "expanded": true,
                "root": "account/license",
                "pages": ["account/permissions", "account/updates", "troubleshooting", "account/support", "account/beta-features", "changelog", "beta-changelog"]
              }
            ]
          },
          {
            "product": "Rivr",
            "icon": "fish",
            "description": "Follow rivers, understand conditions, and keep your fishing log.",
            "groups": [
              {
                "group": "Get Started",
                "expanded": true,
                "root": "rivr/introduction",
                "pages": ["rivr/quickstart", "rivr/find-a-river"]
              },
              {
                "group": "Conditions & Safety",
                "expanded": true,
                "root": "rivr/river-conditions",
                "pages": ["rivr/alerts", "rivr/regulations"]
              },
              {
                "group": "Fishing Tools",
                "expanded": true,
                "root": "rivr/rig-advice",
                "pages": ["rivr/fly-box", "rivr/trip-log"]
              },
              {
                "group": "Settings & Privacy",
                "expanded": true,
                "root": "rivr/settings",
                "pages": ["rivr/data-and-privacy", "rivr/troubleshooting"]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/account/support"
      },
      {
        "label": "Changelog",
        "href": "/changelog"
      },
      {
        "label": "Troubleshooting",
        "href": "/troubleshooting"
      }
    ]
  },
  "footer": {
    "socials": {}
  },
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "family": "Inter",
    "weight": 400
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "redirects": [
    {
      "source": "/guides/first-dashboard",
      "destination": "/quickstart"
    }
  ]
}
