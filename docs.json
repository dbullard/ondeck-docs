{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Relay",
  "description": "Documentation for Relay - a Mac and iPad (Coming Soon) dashboard app for live production teams.",
  "colors": {
    "primary": "#3C63EF",
    "light": "#34C8EE",
    "dark": "#3B2FE0"
  },
  "favicon": "/images/relay-mark.png",
  "logo": "/images/relay-mark.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "directory": "card",
    "anchors": [
      {
        "anchor": "Home",
        "icon": "house",
        "color": {
          "light": "#3C63EF",
          "dark": "#34C8EE"
        },
        "products": [
          {
            "product": "Get Started",
            "icon": "rocket",
            "description": "Install Relay, run the Setup Wizard, and learn the core concepts.",
            "groups": [
              {
                "group": "Get Started",
                "expanded": true,
                "root": "introduction",
                "pages": [
                  "quickstart",
                  "guides/setup-wizard",
                  "core-concepts"
                ]
              }
            ]
          },
          {
            "product": "Build Dashboards",
            "icon": "layout-dashboard",
            "description": "Create tiles, add modules, use variables, and run your show in Live Mode.",
            "groups": [
              {
                "group": "Build Dashboards",
                "expanded": true,
                "root": "dashboards/overview",
                "pages": [
                  "dashboards/tiles",
                  "dashboards/modules",
                  "dashboards/variables",
                  "dashboards/live-mode"
                ]
              },
              {
                "group": "Module guides",
                "expanded": false,
                "pages": [
                  "dashboards/modules/people-planning",
                  "dashboards/modules/audio-visual",
                  "dashboards/modules/video-presentation",
                  "dashboards/modules/wireless",
                  "dashboards/modules/utility"
                ]
              }
            ]
          },
          {
            "product": "Automation",
            "icon": "workflow",
            "description": "Build automations with triggers, actions, utility nodes, and sources.",
            "groups": [
              {
                "group": "Automation",
                "expanded": true,
                "root": "dashboards/automation",
                "pages": [
                  "dashboards/nodes/triggers",
                  "dashboards/nodes/actions",
                  "dashboards/nodes/utilities",
                  "dashboards/nodes/sources"
                ]
              }
            ]
          },
          {
            "product": "Integrations",
            "icon": "plug",
            "description": "Connect Planning Center, ProPresenter, consoles, wireless devices, lighting, and video.",
            "groups": [
              {
                "group": "Integrations",
                "expanded": true,
                "pages": [
                  "integrations/overview"
                ]
              },
              {
                "group": "Production software",
                "expanded": true,
                "pages": [
                  "integrations/planning-center",
                  "integrations/propresenter",
                  "integrations/youtube-live",
                  "integrations/ndi"
                ]
              },
              {
                "group": "Hardware and lighting",
                "expanded": true,
                "pages": [
                  "integrations/audio-consoles",
                  "integrations/wireless-devices",
                  "integrations/lighting",
                  "integrations/vista"
                ]
              }
            ]
          },
          {
            "product": "Protocols",
            "icon": "radio",
            "description": "Send and receive OSC and MIDI, and share tabs over your network.",
            "groups": [
              {
                "group": "Protocols",
                "expanded": true,
                "root": "protocols/overview",
                "pages": [
                  "protocols/osc",
                  "protocols/midi",
                  "protocols/lan-sharing"
                ]
              }
            ]
          },
          {
            "product": "Account & Support",
            "icon": "circle-user",
            "description": "Manage your license, permissions, updates, and support, and read release notes.",
            "groups": [
              {
                "group": "Account & Support",
                "expanded": true,
                "root": "account/license",
                "pages": [
                  "account/permissions",
                  "account/updates",
                  "troubleshooting",
                  "account/support",
                  "account/beta-features"
                ]
              },
              {
                "group": "Release notes",
                "expanded": true,
                "pages": [
                  "changelog",
                  "beta-changelog"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/account/support"
      },
      {
        "label": "Changelog",
        "href": "/changelog"
      },
      {
        "label": "Troubleshooting",
        "href": "/troubleshooting"
      }
    ]
  },
  "footer": {
    "socials": {}
  },
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "family": "Inter",
    "weight": 400
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "redirects": [
    {
      "source": "/guides/first-dashboard",
      "destination": "/quickstart"
    }
  ]
}
