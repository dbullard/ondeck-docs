{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OnDeck",
  "description": "Support documentation for Relay and Rivr by OnDeck.",
  "colors": {
    "primary": "#3C63EF",
    "light": "#34C8EE",
    "dark": "#3B2FE0"
  },
  "favicon": "/images/ondeck-logo.png",
  "logo": "/images/ondeck-logo.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "directory": "card",
    "anchors": [
      {
        "anchor": "Home",
        "icon": "house",
        "color": {
          "light": "#3C63EF",
          "dark": "#34C8EE"
        },
        "products": [
          {
            "product": "Relay",
            "icon": "radio-tower",
            "description": "Build live production dashboards, automations, and integrations.",
            "groups": [
              {
                "group": "Get Started",
                "expanded": true,
                "root": "relay/introduction",
                "pages": [
                  "relay/quickstart",
                  "relay/guides/setup-wizard",
                  "relay/core-concepts"
                ]
              },
              {
                "group": "Build Dashboards",
                "expanded": true,
                "root": "relay/dashboards/overview",
                "pages": [
                  "relay/dashboards/tiles",
                  "relay/dashboards/modules",
                  "relay/dashboards/variables",
                  "relay/dashboards/live-mode"
                ]
              },
              {
                "group": "Module guides",
                "expanded": false,
                "pages": [
                  "relay/dashboards/modules/people-planning",
                  "relay/dashboards/modules/audio-visual",
                  "relay/dashboards/modules/video-presentation",
                  "relay/dashboards/modules/wireless",
                  "relay/dashboards/modules/utility"
                ]
              },
              {
                "group": "Automation",
                "expanded": true,
                "root": "relay/dashboards/automation",
                "pages": [
                  "relay/dashboards/nodes/triggers",
                  "relay/dashboards/nodes/actions",
                  "relay/dashboards/nodes/utilities",
                  "relay/dashboards/nodes/sources"
                ]
              },
              {
                "group": "Integrations",
                "expanded": true,
                "root": "relay/integrations/overview",
                "pages": [
                  "relay/integrations/planning-center",
                  "relay/integrations/propresenter",
                  "relay/integrations/youtube-live",
                  "relay/integrations/ndi",
                  "relay/integrations/audio-consoles",
                  "relay/integrations/wireless-devices",
                  "relay/integrations/lighting",
                  "relay/integrations/vista"
                ]
              },
              {
                "group": "Protocols",
                "expanded": true,
                "root": "relay/protocols/overview",
                "pages": [
                  "relay/protocols/osc",
                  "relay/protocols/midi",
                  "relay/protocols/lan-sharing"
                ]
              },
              {
                "group": "Account & Support",
                "expanded": true,
                "root": "relay/account/license",
                "pages": [
                  "relay/account/permissions",
                  "relay/account/updates",
                  "relay/troubleshooting",
                  "relay/account/support",
                  "relay/account/beta-features",
                  "relay/changelog",
                  "relay/beta-changelog"
                ]
              }
            ]
          },
          {
            "product": "Rivr",
            "icon": "waves",
            "description": "Follow rivers, understand conditions, and keep your fishing log.",
            "groups": [
              {
                "group": "Get Started",
                "expanded": true,
                "root": "rivr/introduction",
                "pages": [
                  "rivr/quickstart",
                  "rivr/find-a-river"
                ]
              },
              {
                "group": "Conditions & Safety",
                "expanded": true,
                "root": "rivr/river-conditions",
                "pages": [
                  "rivr/alerts",
                  "rivr/regulations"
                ]
              },
              {
                "group": "Fishing Tools",
                "expanded": true,
                "root": "rivr/rig-advice",
                "pages": [
                  "rivr/fly-box",
                  "rivr/trip-log"
                ]
              },
              {
                "group": "Settings & Privacy",
                "expanded": true,
                "root": "rivr/settings",
                "pages": [
                  "rivr/data-and-privacy",
                  "rivr/privacy-policy",
                  "rivr/troubleshooting"
                ]
              }
            ]
          }
        ]
      }
    ]
