{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OnDeck",
  "description": "Support documentation for Relay and Rivr by OnDeck.",
  "colors": {
    "primary": "#3C63EF",
    "light": "#34C8EE",
    "dark": "#3B2FE0"
  },
  "favicon": "/images/ondeck-logo.png",
  "logo": "/images/ondeck-logo.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "mcp",
      "add-mcp"
    ]
  },
  "navigation": {
    "directory": "card",
    "anchors": [
      {
        "anchor": "Home",
        "icon": "house",
        "color": {
          "light": "#3C63EF",
          "dark": "#34C8EE"
        },
        "products": [
          {
            "product": "Relay",
            "icon": "radio-tower",
            "description": "Build live production dashboards, automations, and integrations.",
            "groups": [
              {
                "group": "Relay has moved to GitHub",
                "expanded": true,
                "pages": [
                  "relay/privacy-policy",
                  "relay/terms-conditions"
                ]
              }
            ]
          },
          {
            "product": "Rivr",
            "icon": "waves",
            "description": "Follow rivers, understand conditions, and keep your fishing log.",
            "groups": [
              {
                "group": "Get Started",
                "expanded": true,
                "root": "rivr/introduction",
                "pages": [
                  "rivr/quickstart",
                  "rivr/find-a-river"
                ]
              },
              {
                "group": "Conditions & Safety",
                "expanded": true,
                "root": "rivr/river-conditions",
                "pages": [
                  "rivr/alerts",
                  "rivr/regulations"
                ]
              },
              {
                "group": "Fishing Tools",
                "expanded": true,
                "root": "rivr/rig-advice",
                "pages": [
                  "rivr/fly-box",
                  "rivr/trip-log"
                ]
              },
              {
                "group": "Settings & Privacy",
                "expanded": true,
                "root": "rivr/settings",
                "pages": [
                  "rivr/data-and-privacy",
                  "rivr/privacy-policy",
                  "rivr/terms-of-use",
                  "rivr/attributions",
                  "rivr/troubleshooting"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/relay/account/support"
      },
      {
        "label": "Changelog",
        "href": "/relay/changelog"
      },
      {
        "label": "Troubleshooting",
        "href": "/relay/troubleshooting"
      }
    ]
  },
  "footer": {
    "socials": {}
  },
  "background": {
    "decoration": "grid"
  },
  "fonts": {
    "family": "Inter",
    "weight": 400
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
